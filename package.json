{
  "name": "my-react-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://app.ritvikgoyal.com",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "build:signature": "VITE_SITE_DESIGN=signature VITE_SITE_URL=https://ritvikgoyal.com npm run build",
    "build:all": "npm run build && npm run build:signature",
    "dev:signature": "VITE_SITE_DESIGN=signature VITE_SITE_URL=https://ritvikgoyal.com vite",
    "preview:signature": "vite preview --outDir dist-signature"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@mui/base": "^5.0.0-alpha.118",
    "@mui/icons-material": "^6.4.5",
    "@mui/material": "^6.4.4",
    "@mui/styled-engine-sc": "^6.4.0",
    "@radix-ui/react-label": "^2.1.1",
    "@tabler/icons-react": "^3.26.0",
    "@types/react-helmet": "^6.1.11",
    "aos": "^2.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.1.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.186.1",
    "web-vitals": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@types/aos": "^3.0.7",
    "@types/node": "^22.10.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "gh-pages": "^6.2.0",
    "globals": "^15.13.0",
    "postcss": "^8.5.1",
    "prettier": "^3.5.1",
    "tailwindcss": "^3.4.17",
    "terser": "^5.39.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.3",
    "wrangler": "^4.151.0"
  }
}
